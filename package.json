{
  "name": "nfc-service",
  "version": "1.0.0",
  "description": "Servicio NFC para ACR122U",
  "main": "nfc-service.js",
  "scripts": {
    "start": "node nfc-service.js",
    "build": "pkg nfc-service.js --targets node18-win-x64 --output nfc-service.exe"
  },
  "pkg": {
    "assets": [
      "console.html",
      "tray-*.png",
      "tray-*.ico",
      "node_modules/systray2/traybin/*"
    ]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "nfc-pcsc": "^0.8.1",
    "socket.io-client": "^4.8.3",
    "systray2": "^2.1.4",
    "ws": "^8.18.3"
  }
}
